# Copy to .env and fill in. Anything left empty runs in MOCK mode
# (fully testable offline) — see README "What's stubbed".

# ---- core ----
# Local dev only. Anything else (incl. an UNSET value — the code default is
# "production") enforces production safety: JWT_SECRET must be 32+ random
# chars (known placeholders like the one below are rejected) and
# ENCRYPTION_KEY must be a 32-byte hex string, or the process refuses to boot.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://bseo:bseo@postgres:5432/bseo
REDIS_URL=redis://redis:6379
# Generate: openssl rand -hex 32  (min 32 chars; never reuse the placeholder)
JWT_SECRET=change-me-to-a-random-32-char-string
# Dev/test only: HMAC secret required to POST mock Stripe webhooks to
# /api/v1/billing/webhook. Mock webhooks are always disabled in production.
MOCK_WEBHOOK_SECRET=change-me-to-a-random-32-char-string
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# 32-byte hex used to encrypt stored OAuth/API keys (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# ---- Frontend / same-origin API proxy ----
# The browser calls relative /api/* URLs; this Next.js route proxies them to
# the API origin below, read from the RUNTIME environment on every request
# (never baked into the client bundle). NEXT_PUBLIC_API_URL is only needed
# when bypassing the proxy (browser -> API directly); it is inlined at
# frontend BUILD time, so changing it requires a rebuild.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:4000

# ---- Prod deploy (Caddyfile.prod / docker-compose.prod.yml) ----
# Bare hostnames for the Caddyfile ({$APP_HOST}, {$API_HOST}) and the ACME
# account email for automatic TLS certificates.
APP_HOST=
API_HOST=
APP_TLS_EMAIL=

# ---- Stripe (empty => mock billing, full flow still testable) ----
STRIPE_SECRET_KEY=
# REQUIRED whenever STRIPE_SECRET_KEY is set — boot fails fast without it (N-A2-6)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Annual price IDs (optional; read as STRIPE_PRICE_<PLAN>_ANNUAL). Without
# these, annual checkout errors with "No STRIPE_PRICE_*_ANNUAL configured".
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=

# ---- Google OAuth / Search Console (empty => mock Google data) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gsc/callback
# Dev/test only: mock Google profile knobs for S-01 merge-rule tests.
# MOCK_GOOGLE_EMAIL_VERIFIED=false simulates a Google account whose email is
# NOT verified (must never merge into a local account).
# MOCK_GOOGLE_EMAIL_VERIFIED=true
# MOCK_GOOGLE_EMAIL=

# ---- DataForSEO keyword+SERP data (empty => mock data, cached) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- LLM (first available key wins; none => mock drafts) ----
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Default per-tenant LLM word budget when the tenant has no explicit cap
# (services/llmMetered.ts). 0/unset = no env-level default.
LLM_TENANT_DEFAULT_CAP_WORDS=

# ---- Notifications (empty => logged to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Beyonix SEO <noreply@beyonixseo.com>
TELEGRAM_BOT_TOKEN=

# ---- F-04: CMS publish connector (WordPress/Webflow, HTTPS-only) ----
# Off by default. When off, publish endpoints run in honest mock mode.
CMS_PUBLISH_ENABLED=false

# ---- Q-03: observability hooks (env-gated, no hard dependency) ----
# SENTRY_DSN=           # when set, the operator wraps the process with Sentry
# OTEL_EXPORTER_OTLP_ENDPOINT=  # when set, an OTel collector export pipeline can be attached
# (API-side logs are pino JSON by default; GET /metrics exposes Prometheus series; GET /status gives JSON status)
# METRICS_BASIC_AUTH="user:password"  # when set, /metrics and /status require
#   HTTP Basic auth (constant-time compare). Unset = open (scraper-friendly
#   default); SET IT IN PRODUCTION — /metrics exposes spend/queue intel.

# ---- S-03: proxy / rate-limit / signup abuse protection ----
# Trust X-Forwarded-For for req.ip (rate limits). Default false (fail closed).
# Set TRUST_PROXY=true (or hop count, e.g. "1") when behind a proxy you control.
TRUST_PROXY=false
# Global per-IP requests/minute (Redis-backed, shared across API instances).
RATE_LIMIT_PER_MIN=300
# Login lockout: failures before lockout, then exponential backoff.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_MIN=5
LOGIN_LOCKOUT_MAX_MIN=60
# Optional disposable-email block on signup (curated throwaway-domain list).
DISPOSABLE_EMAIL_BLOCK=false
# CAPTCHA on signup: none | hcaptcha | test (test-only knob).
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=
CAPTCHA_SITEKEY=
# Per-tenant hourly budget for expensive endpoints (keyword research,
# content/GEO generation). Re-read per request; no reboot needed to tune.
TENANT_EXPENSIVE_LIMIT_PER_HOUR=30

# ---- S-04: OAuth state binding ----
# HMAC secret for the signed OAuth-state cookie (browser binding). Falls back
# to JWT_SECRET when unset, but a dedicated value is recommended.
COOKIE_SECRET=
# Strict per-IP limit on auth endpoints (login/signup/reset). Default 20/min.
# Tests raise it via AUTH_RATE_LIMIT_PER_MIN; production should keep it low.
AUTH_RATE_LIMIT_PER_MIN=20
# Frontend: public site URL used by sitemap.xml/robots.txt and SEO meta.
NEXT_PUBLIC_SITE_URL=

# ---- S-06: cookies / CSRF / CORS ----
# SameSite for the auth + CSRF cookies: lax (default; correct for the
# same-origin /api proxy) | strict | none (split app/api domains WITHOUT the
# proxy — forces Secure, browsers require it for SameSite=None).
COOKIE_SAMESITE=lax
# CORS allow-list: comma-separated origins, env ONLY. Unset => APP_URL only.
CORS_ORIGINS=

# ---- S-10: container secrets (REQUIRED by docker-compose.yml) ----
# Compose fails fast (`:?` guards) when these are missing. Generate:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# NOTE: REDIS_URL must embed the Redis password in compose:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
# (compose sets this for you from REDIS_PASSWORD — shown here for clarity)

# ---- S-07: encryption key versioning ----
# Versioned keys: "kid:hex,kid:hex,..." — FIRST entry is the primary used for
# all new encryptions; older entries are kept so existing ciphertext still
# decrypts. Takes precedence over ENCRYPTION_KEY when set.
# Rotation: generate a new key, put it first, run
#   npm run rotate-keys -- --dry-run   # then without --dry-run
# and only then remove the old kid.
ENCRYPTION_KEYS=

# ---- W-01/D4-M-2: scale & provider cost guardrails ----
# Worker concurrency per queue CLASS (worker.ts queueConcurrency):
# heavy = crawl/audit jobs, light = everything else.
WORKER_HEAVY_CONCURRENCY=6
WORKER_LIGHT_CONCURRENCY=3
# Global daily provider-spend circuit (services/providerGuard.ts): kills ALL
# new DataForSEO spend for the day once EITHER cap is reached. 0 = disabled.
GLOBAL_PROVIDER_DAILY_CAP_CENTS=0
GLOBAL_PROVIDER_DAILY_CAP_UNITS=0
# Per-feature provider cost calibration, in US cents per unit, for DataForSEO
# spend accounting (services/providerGuard.ts priceProviderUnits). Unset =
# built-in defaults (keyword_metrics=0.1, serp=0.2, serp_snapshot=0.2,
# keyword_gap=0.2). Raise/lower to match your actual DataForSEO plan costs.
# PROVIDER_PRICE_KEYWORD_METRICS_CENTS=
# PROVIDER_PRICE_SERP_CENTS=
# PROVIDER_PRICE_SERP_SNAPSHOT_CENTS=
# PROVIDER_PRICE_KEYWORD_GAP_CENTS=

# ---- Misc knobs ----
# Query budget guardrail: per-statement timeout in ms applied to the pg pool
# (db.ts). 0/unset = no statement timeout.
DB_STATEMENT_TIMEOUT_MS=
# Demo seeding: `npm run seed` refuses production unless SEED_DEMO=1 is set
# deliberately. Never enable on a real production database.
# SEED_DEMO=
# PageSpeed Insights daily quota (C-04): free tier guarded so crawls never
# burn it; results cached 7 days. No key is required at current volumes
# (services/pagespeed.ts calls the API keyless).
PAGESPEED_DAILY_QUOTA=25
# PAGESPEED_API_KEY=
# Tests-only: BSEO_REDIS_PREFIX namespaces the app's Redis keys per run.
# BSEO_REDIS_PREFIX=

# ---- Trial gate (Wave 4) ----
# Server-side trial length for new signups (days). Default 14. After the
# trial expires with no live subscription, spend routes return 402
# SUBSCRIPTION_REQUIRED and the tenant is flipped read-only.
# E5-L-1: this knob was code-only; now documented.
SIGNUP_TRIAL_DAYS=14
