# Copy to .env and fill in. Anything left empty runs in MOCK mode
# (fully testable offline) — see README "What's stubbed".

# ---- core ----
# Local dev only. Anything else (incl. an UNSET value — the code default is
# "production") enforces production safety: JWT_SECRET must be 32+ random
# chars (known placeholders like the one below are rejected) and
# ENCRYPTION_KEY must be a 32-byte hex string, or the process refuses to boot.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://bseo:bseo@postgres:5432/bseo
REDIS_URL=redis://redis:6379
# Generate: openssl rand -hex 32  (min 32 chars; never reuse the placeholder)
JWT_SECRET=change-me-to-a-random-32-char-string
# Dev/test only: HMAC secret required to POST mock Stripe webhooks to
# /api/v1/billing/webhook. Mock webhooks are always disabled in production.
MOCK_WEBHOOK_SECRET=change-me-to-a-random-32-char-string
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# 32-byte hex used to encrypt stored OAuth/API keys (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# ---- Stripe (empty => mock billing, full flow still testable) ----
STRIPE_SECRET_KEY=
# REQUIRED whenever STRIPE_SECRET_KEY is set — boot fails fast without it (N-A2-6)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ---- Google OAuth / Search Console (empty => mock Google data) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gsc/callback
# Dev/test only: mock Google profile knobs for S-01 merge-rule tests.
# MOCK_GOOGLE_EMAIL_VERIFIED=false simulates a Google account whose email is
# NOT verified (must never merge into a local account).
# MOCK_GOOGLE_EMAIL_VERIFIED=true
# MOCK_GOOGLE_EMAIL=

# ---- DataForSEO keyword+SERP data (empty => mock data, cached) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- LLM (first available key wins; none => mock drafts) ----
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Notifications (empty => logged to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Beyonix SEO <noreply@beyonixseo.com>
TELEGRAM_BOT_TOKEN=

# ---- S-03: proxy / rate-limit / signup abuse protection ----
# Trust X-Forwarded-For for req.ip (rate limits). Default false (fail closed).
# Set TRUST_PROXY=true (or hop count, e.g. "1") when behind a proxy you control.
TRUST_PROXY=false
# Global per-IP requests/minute (Redis-backed, shared across API instances).
RATE_LIMIT_PER_MIN=300
# Login lockout: failures before lockout, then exponential backoff.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_MIN=5
LOGIN_LOCKOUT_MAX_MIN=60
# Optional disposable-email block on signup (curated throwaway-domain list).
DISPOSABLE_EMAIL_BLOCK=false
# CAPTCHA on signup: none | hcaptcha | test (test-only knob).
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=
CAPTCHA_SITEKEY=
# Per-tenant hourly budget for expensive endpoints (keyword research,
# content/GEO generation). Re-read per request; no reboot needed to tune.
TENANT_EXPENSIVE_LIMIT_PER_HOUR=30

# ---- S-04: OAuth state binding ----
# HMAC secret for the signed OAuth-state cookie (browser binding). Falls back
# to JWT_SECRET when unset, but a dedicated value is recommended.
COOKIE_SECRET=
# Strict per-IP limit on auth endpoints (login/signup/reset). Default 20/min.
# Tests raise it via AUTH_RATE_LIMIT_PER_MIN; production should keep it low.
AUTH_RATE_LIMIT_PER_MIN=20
